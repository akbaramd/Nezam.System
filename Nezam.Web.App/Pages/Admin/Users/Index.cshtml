@page
@model Nezam.System.Web.Pages.Admin.Users.IndexModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
ViewBag.ptitle = "مدیریت کاربران";
ViewBag.pagetitle = "لیست کاربران";

}



@section styles{
<!-- Sweet Alert css-->
<link href="~/assets/libs/sweetalert2/sweetalert2.min.css" rel="stylesheet" type="text/css" />
}
@Html.AntiForgeryToken()
<div class="row">
    <div class="col-md-12 mb-3">
        <a class="btn btn-primary" asp-page="/Admin/Users/Create">افزودن کاربر جدید</a>
    </div>
    <!-- Search Form -->
    <div class="col-md-12 mb-3">
        <form method="get" class="input-group">
            <input type="text" name="SearchQuery" value="@Model.SearchQuery" class="form-control" placeholder="جستجوی کاربر با نام کاربری، ایمیل یا شماره موبایل..."/>
            <button class="btn btn-primary" type="submit">جستجو</button>
        </form>
    </div>
    <!-- User Table Section -->
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title">لیست کاربران</h5>
            </div>
            <div class="card-body">
                <table class="table table-striped mt-3">
                    <thead>
                    <tr>
                        <th>نام کاربری</th>
                        <th>ایمیل</th>
                        <th>شماره موبایل</th>
                        <th>عملیات</th>
                    </tr>
                    </thead>
                    <tbody>
                    @if (Model.Users.Any())
                    {
                        @foreach (var user in Model.Users)
                        {
                            <tr id="user-row-@user.Id">
                                <td>@user.UserName</td>
                                <td>@user.Email</td>
                                <td>@user.PhoneNumber</td>
                                <td>
                                    <a asp-page="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-primary">ویرایش</a>
                                    <button type="button" class="btn btn-sm btn-danger delete-user-btn" data-user-id="@user.Id">حذف</button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center">هیچ کاربری یافت نشد.</td>
                        </tr>
                    }
                    </tbody>
                </table>
                <nav aria-label="Page navigation">
                    <ul class="pagination justify-content-center">
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a class="page-link"
                               asp-page="./Index"
                               asp-route-CurrentPage="@i"
                               asp-route-SearchQuery="@Model.SearchQuery">@i</a>
                        </li>
                        }
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <!-- App js -->
    <script src="~/assets/js/app.js"></script>
    <!-- SweetAlert2 js -->
    <script src="~/assets/libs/sweetalert2/sweetalert2.min.js"></script>
    <script>
        class UserManagement {
            constructor() {
                this.init();
            }

            init() {
                // Bind event handlers
                this.bindDeleteUserButtons();
            }

            bindDeleteUserButtons() {
                const deleteButtons = document.querySelectorAll('.delete-user-btn');
                deleteButtons.forEach(button => {
                    button.addEventListener('click', (event) => this.handleDeleteButtonClick(event));
                });
            }

            handleDeleteButtonClick(event) {
                const button = event.currentTarget;
                const userId = button.getAttribute('data-user-id');
                const row = document.getElementById(`user-row-${userId}`);

                // SweetAlert confirmation dialog
                Swal.fire({
                    title: 'آیا مطمئن هستید؟',
                    text: "این عملیات قابل بازگشت نیست!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'بله، حذف شود!',
                    cancelButtonText: 'لغو'
                }).then((result) => {
                    if (result.isConfirmed) {
                        this.deleteUser(userId, row);
                    }
                });
            }

            deleteUser(userId, row) {
                $.ajax({
                    url: this.getDeleteUrl(),
                    type: 'POST',
                    data: {
                        id: userId,
                        __RequestVerificationToken: this.getCsrfToken()
                    },
                    beforeSend: (xhr) => {
                        xhr.setRequestHeader("XSRF-TOKEN", this.getCsrfToken());
                    },
                    success: (response) => this.handleDeleteSuccess(response, row),
                    error: this.handleDeleteError
                });
            }

            getDeleteUrl() {
                return '@Url.Page("./Index", new { handler = "Delete" })';
            }

            getCsrfToken() {
                return document.querySelector('input[name="__RequestVerificationToken"]').value;
            }

            handleDeleteSuccess(response, row) {
                if (response.success) {
                    Swal.fire(
                        'حذف شد!',
                        response.message,
                        'success'
                    ).then(() => {
                        // Reload the page after successful deletion
                        window.location.reload();
                    });
                } else {
                    Swal.fire(
                        'خطا!',
                        response.message || 'خطایی رخ داده است.',
                        'error'
                    );
                }
            }

            handleDeleteError() {
                Swal.fire(
                    'خطا!',
                    'خطایی در ارسال درخواست به وجود آمد.',
                    'error'
                );
            }
}

        // Initialize the UserManagement class when the document is ready
        document.addEventListener('DOMContentLoaded', () => {
            new UserManagement();
        });

    </script>
}

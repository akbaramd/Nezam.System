@page
@model Nezam.System.Web.Pages.Documents.IndexModel
@{
    ViewBag.ptitle = "گزارشات خلافی";
    ViewBag.pagetitle = "لیست گزارشات";

}
@section styles{
    <!-- DataTable CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.11.5/css/dataTables.bootstrap5.min.css"/>
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.2.9/css/responsive.bootstrap.min.css"/>
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.2.2/css/buttons.dataTables.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

    <style>
        /* RTL Support */

        div.dataTables_wrapper div.dataTables_filter input {
            margin-right: .5em !important;
        }
        body {
            direction: rtl;
            text-align: right;
        }

        .dataTables_wrapper .dataTables_filter,
        .dataTables_wrapper .dataTables_info {
            float: right !important;
            text-align: right !important;
        }
    </style>
}

<div class="row">
    <div class="col-md-12">
        <div class="card shadow">
            <div class="card-header">
                <h4 class="mb-0">گزارش اسناد</h4>
            </div>
            <div class="card-body">
                <form method="post">
                    @Html.AntiForgeryToken()
                </form>

                <div class="">
                    <table id="documentsTable" class="table table-bordered table-striped">
                        <thead class="table-light">
                        <tr>
                            <th>شناسه</th>
                            <th>عنوان</th>
                            <th>کد پیگیری</th>
                            <th>تاریخ ایجاد</th>
                            <th>وضعیت</th>
                            <th>نوع</th>
                            <th>عملیات</th>
                        </tr>
                        </thead>
                    </table>
                </div>
            </div>

        </div>
    </div>
</div>

@section scripts
{
    <!-- DataTable JS -->
    <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.11.5/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.2.9/js/dataTables.responsive.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.2.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.2.2/js/buttons.print.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.2.2/js/buttons.html5.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/vfs_fonts.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.1.3/jszip.min.js"></script>

    <script>
        $(document).ready(function () {
            $('#documentsTable').DataTable({
                processing: true,
                serverSide: true,
                ajax: {
                    url: '@Url.Page("Index")?handler=GetDocuments',
                    type: 'POST',
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    }
                },
                columns: [
                    { data: 'id' },
                    { data: 'title' },
                    { data: 'trackingCode' },
                    { data: 'createdAt' },
                    { data: 'state' },
                    { data: 'type' },
                    {
                        data: null, // ✅ Use "null" because we are combining multiple actions
                        render: function (data, type, row) {
                            if (!row) return ""; // ✅ Prevents undefined row errors

                            const baseUrl = 'https://test.wa-nezam.org/';
                            const fileUrl = `${baseUrl}${row.filePath}`;

                            const btnClass = row.isRead ? 'btn-success' : 'btn-secondary';
                            const btnText = row.isRead ? 'خوانده شده' : 'خوانده نشده';

                            return `
                            <div class="d-flex">
                                <!-- Download Button -->
                                <a target="_blank" href="${fileUrl}" class="btn btn-primary btn-sm me-2 download-btn" 
                                   data-id="${row.id}">
                                    <i class="fas fa-download"></i> دانلود
                                </a>

                                <!-- Read/Unread Button -->
                                <button class="btn ${btnClass} btn-sm toggle-read" 
                                    data-id="${row.id}" data-status="${row.isRead}">
                                    <i class="fas fa-eye"></i> ${btnText}
                                </button>
                            </div>
                        `;
                        }
                    }
                ],
                responsive: true,
                dom: 'Bfrtip',
                buttons: [
                    {
                        extend: 'excelHtml5',
                        text: '<i class="fas fa-file-excel"></i> خروجی اکسل',
                        className: 'btn btn-success btn-sm'
                    },
                    {
                        extend: 'pdfHtml5',
                        text: '<i class="fas fa-file-pdf"></i> خروجی PDF',
                        className: 'btn btn-danger btn-sm'
                    },
                    {
                        extend: 'print',
                        text: '<i class="fas fa-print"></i> چاپ',
                        className: 'btn btn-secondary btn-sm'
                    }
                ],
                language: {
                    emptyTable: "هیچ داده‌ای موجود نیست",
                    processing: "در حال پردازش...",
                    paginate: { next: "بعدی", previous: "قبلی" },
                    search: "جستجو:",
                    lengthMenu: "نمایش _MENU_ رکورد در هر صفحه",
                    info: "نمایش _START_ تا _END_ از _TOTAL_ رکورد",
                    infoEmpty: "نمایش 0 تا 0 از 0 رکورد",
                    infoFiltered: "(فیلتر شده از _MAX_ رکورد کل)"
                }
            });

            // Handle Read/Unread Button Click
            $('#documentsTable tbody').on('click', '.toggle-read', function () {
                let button = $(this);
                let documentId = button.data('id');
                let currentStatus = button.data('status');

                $.ajax({
                    url: '@Url.Page("Index")?handler=ToggleReadStatus',
                    type: 'POST',
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    contentType: "application/json",
                    data: JSON.stringify({ documentId: documentId, isRead: !currentStatus }),
                    success: function (response) {
                        if (response.success) {
                            // Toggle button state
                            button.data('status', !currentStatus);
                            button.toggleClass('btn-success btn-secondary');
                            button.html(`<i class="fas fa-eye"></i> ${!currentStatus ? 'خوانده شده' : 'خوانده نشده'}`);
                        } else {
                            alert("خطا در تغییر وضعیت خوانده شده!");
                        }
                    },
                    error: function () {
                        alert("مشکلی رخ داده است. دوباره تلاش کنید.");
                    }
                });
            });

        });
    </script>


}

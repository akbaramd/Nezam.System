@using Nezam.System.Web
@using Nezam.System.Web.Data.Cedo // Ensure correct namespace
@{
// Instantiate MenuService with the current user's claims
var menuService = new MenuService(User);
var menuItems = menuService.GetMenu();

}

<!-- ========== App Menu ========== -->
<div class="app-menu navbar-menu">
    <!-- LOGO -->
    <!-- ... your existing code for the logo ... -->

    <div id="scrollbar">
        <div class="container-fluid">
            <div id="two-column-menu"></div>
            <ul class="navbar-nav" id="navbar-nav">
                <li class="menu-title">
                    <span data-key="t-menu">Menu</span>
                </li>
                @foreach (var menuItem in menuItems)
                {
                    // Generate a unique ID for each collapsible menu item
                    var uniqueId = "menu-" + Guid.NewGuid().ToString("N");

                    @if (menuItem.Children.Any()) // Dropdown item with children
                    {
                        <li class="nav-item">
                            <a class="nav-link menu-link" href="#"
                               data-bs-toggle="collapse"
                               role="button"
                               aria-expanded="false"
                               aria-controls="@uniqueId">
                                @if (!string.IsNullOrEmpty(menuItem.Icon))
                                {
                                    <i class="@menuItem.Icon"></i>
                                }
                                <span>@menuItem.Title</span>
                            </a>
                            <div class="collapse menu-dropdown" id="@uniqueId">
                                <ul class="nav nav-sm flex-column">
                                    @foreach (var child in menuItem.Children)
                                    {
                                        var childUniqueId = "submenu-" + Guid.NewGuid().ToString("N");

                                        @if (child.Children.Any()) // Nested dropdown
                                        {
                                            <li class="nav-item">
                                                <a class="nav-link" href="#"
                                                   data-bs-toggle="collapse"
                                                   role="button"
                                                   aria-expanded="false"
                                                   aria-controls="@childUniqueId">
                                                    @if (!string.IsNullOrEmpty(child.Icon))
                                                    {
                                                        <i class="@child.Icon"></i>
                                                    }
                                                    <span>@child.Title</span>
                                                </a>
                                                <div class="collapse menu-dropdown" id="@childUniqueId">
                                                    <ul class="nav nav-sm flex-column">
                                                        @foreach (var grandChild in child.Children)
                                                        {
                                                            <li class="nav-item">
                                                                <a class="nav-link" asp-page="@grandChild.Page">
                                                                    @grandChild.Title
                                                                </a>
                                                            </li>
                                                        }
                                                    </ul>
                                                </div>
                                            </li>
                                        }
                                        else // Simple link (no children)
                                        {
                                            <li class="nav-item">
                                                <a class="nav-link" asp-page="@child.Page">
                                                    @if (!string.IsNullOrEmpty(child.Icon))
                                                    {
                                                        <i class="@child.Icon"></i>
                                                    }
                                                    <span>@child.Title</span>
                                                </a>
                                            </li>
                                        }
                                    }
                                </ul>
                            </div>
                        </li>
                    }
                    else // Simple link (no children)
                    {
                        <li class="nav-item">
                            <a class="nav-link menu-link" asp-page="@menuItem.Page">
                                @menuItem.Title
                            </a>
                        </li>
                    }
                }
            </ul>
        </div>
    </div>
    <div class="sidebar-background"></div>
</div>
<!-- Left Sidebar End -->
<!-- Vertical Overlay-->
<div class="vertical-overlay"></div>
